{
  "compilerOptions": {
    "target": "ES2020",
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@omnipulse/shared-ui": ["packages/shared-ui/src"],
      "@omnipulse/api-client": ["packages/api-client/src"],
      "@omnipulse/types": ["packages/types/src"],
      "@omnipulse/utils": ["packages/utils/src"]
    }
  }
}
